# Build output
bin/
*.prg
*.prg.debug.xml
*.iq

# Signing keys -- never commit these; the store ties your app id to the key
developer_key
developer_key.pem
*.der

# Claude Code -- .claude/ is shared; local overrides are not
.claude/settings.local.json

# Editors
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Preview renders, except the ones the README shows
preview*.png
!docs/img/preview*.png

# Overpass caches
*.osm.cache
tools/mappack/*.osm

# The demo pack IS committed so the repo builds out of the box. A personal
# pack overwrites mapdata/active/ on disk (make build reads nothing else), so
# this only keeps the new block files it adds out of `git status`/`git add -A`;
# the demo files already tracked still show as modified until `make demo`
# restores them -- see docs/PACKER.md.
mapdata/active/
.DS_Store

# Isolated implementation workspaces
.worktrees/

# Personal packs built alongside the committed demo
mapdata/berlin/
mapdata/raster/
!mapdata/raster-demo/

# Local city catalogue for `make catalogue`
.catalogue/
