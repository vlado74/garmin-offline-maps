# Build output
bin/
*.prg
*.prg.debug.xml
*.iq

# Signing keys -- never commit these; the store ties your app id to the key
developer_key
developer_key.pem
*.der

# Claude Code -- .claude/ is shared; local overrides are not
.claude/settings.local.json

# Editors
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Preview renders, except the ones the README shows
preview*.png
!docs/img/preview*.png

# Overpass caches
*.osm.cache
tools/mappack/*.osm

.DS_Store

# Isolated implementation workspaces
.worktrees/

# Personal raster packs built alongside the synthetic demo
mapdata/raster/
!mapdata/raster-demo/
