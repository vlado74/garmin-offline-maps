import Toybox.Graphics;

//! Colors shared by the raster running screen.
module RunStyle {
    const MAP_BACKGROUND = 0xF2EFE7;
    const TEXT = Graphics.COLOR_BLACK;
    const DIM = Graphics.COLOR_DK_GRAY;
    const MARKER = 0x00D7FF;
    const MARKER_OUTLINE = Graphics.COLOR_BLACK;
    const HOME = 0xFF4040;
    const BAND = Graphics.COLOR_BLACK;
    const BAND_TEXT = Graphics.COLOR_WHITE;
    const READY = 0x40E060;
    const RECORDING = 0x00D7FF;
    const PAUSED = 0xFFB020;
    const ERROR = 0xFF4040;
}
